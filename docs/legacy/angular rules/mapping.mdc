## Map Layers and Data

### Layer Service

```typescript
// services/map-layers.service.ts
import { Injectable, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';
import * as L from 'leaflet';

export interface MapLayer {
  id: string;
  name: string;
  visible: boolean;
  layerInstance?: L.Layer;
}

export interface SiteMarker {
  id: string;
  name: string;
  lat: number;
  lng: number;
  type: 'existing' | 'proposed';
  properties: Record<string, any>;
}

@Injectable({
  providedIn: 'root'
})
export class MapLayersService {
  private layersSignal = signal<MapLayer[]>([
    { id: 'sites', name: 'Sites', visible: true },
    { id: 'traffic', name: 'Traffic Data', visible: false },
    { id: 'demographics', name: 'Demographics', visible: false },
  ]);

  layers = this.layersSignal.asReadonly();

  constructor(private http: HttpClient) {}

  toggleLayer(layerId: string): void {
    this.layersSignal.update(layers =>
      layers.map(layer =>
        layer.id === layerId ? { ...layer, visible: !layer.visible } : layer
      )
    );
  }

  getSites(): Observable<SiteMarker[]> {
    return this.http.get<SiteMarker[]>('/api/sites');
  }

  getTrafficData(bounds: L.LatLngBounds): Observable<GeoJSON.FeatureCollection> {
    const bbox = `${bounds.getSouthWest().lng},${bounds.getSouthWest().lat},${bounds.getNorthEast().lng},${bounds.getNorthEast().lat}`;
    return this.http.get<GeoJSON.FeatureCollection>(`/api/traffic?bbox=${bbox}`);
  }
}
```

### Interactive Map Component

```typescript
// components/map/interactive-map/interactive-map.component.ts
import { Component, OnInit, OnDestroy, AfterViewInit, signal, computed, ElementRef, ViewChild, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import * as L from 'leaflet';
import { MapLayersService, type SiteMarker } from '@/services/map-layers.service';
import { LEAFLET_CONFIG } from '@/lib/map/leaflet-config';

@Component({
  selector: 'app-interactive-map',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './interactive-map.component.html',
  styleUrls: ['./interactive-map.component.css']
})
export class InteractiveMapComponent implements AfterViewInit, OnDestroy {
  @ViewChild('mapContainer', { static: true }) mapContainer!: ElementRef<HTMLDivElement>;
  
  private mapLayersService = inject(MapLayersService);
  private map: L.Map | null = null;
  private markers: L.Marker[] = [];
  private layerGroups: Map<string, L.LayerGroup> = new Map();

  isLoaded = signal(false);
  sites = signal<SiteMarker[]>([]);
  selectedSite = signal<SiteMarker | null>(null);

  layers = this.mapLayersService.layers;

  visibleLayers = computed(() => 
    this.layers().filter(layer => layer.visible)
  );

  ngAfterViewInit(): void {
    this.initializeMap();
    this.loadSites();
    this.watchLayerChanges();
  }

  private initializeMap(): void {
    if (this.map) return;

    this.map = L.map(this.mapContainer.nativeElement, {
      center: [LEAFLET_CONFIG.defaultCenter.lat, LEAFLET_CONFIG.defaultCenter.lng],
      zoom: LEAFLET_CONFIG.defaultZoom,
      maxBounds: LEAFLET_CONFIG.maxBounds as L.LatLngBoundsExpression,
    });

    L.tileLayer(LEAFLET_CONFIG.tileLayer.url, {
      attribution: LEAFLET_CONFIG.tileLayer.attribution,
      maxZoom: LEAFLET_CONFIG.tileLayer.maxZoom,
    }).addTo(this.map);

    this.map.whenReady(() => {
      this.isLoaded.set(true);
    });
  }

  private loadSites(): void {
    this.mapLayersService.getSites().subscribe({
      next: (sites) => {
        this.sites.set(sites);
        this.addSiteMarkers(sites);
      },
      error: (error) => console.error('Failed to load sites', error)
    });
  }

  private addSiteMarkers(sites: SiteMarker[]): void {
    if (!this.map) return;

    // Clear existing markers
    this.markers.forEach(marker => marker.remove());
    this.markers = [];

    // Create site markers layer group
    const sitesLayer = L.layerGroup();
    this.layerGroups.set('sites', sitesLayer);

    sites.forEach(site => {
      const icon = this.createSiteIcon(site.type);
      const marker = L.marker([site.lat, site.lng], { icon })
        .on('click', () => this.onMarkerClick(site));
      
      this.markers.push(marker);
      sitesLayer.addLayer(marker);
    });

    sitesLayer.addTo(this.map!);
  }

  private createSiteIcon(type: 'existing' | 'proposed'): L.Icon {
    return L.icon({
      iconUrl: `/assets/markers/${type}-site.png`,
      iconSize: [32, 32],
      iconAnchor: [16, 32],
      popupAnchor: [0, -32],
    });
  }

  private onMarkerClick(site: SiteMarker): void {
    this.selectedSite.set(site);
  }

  private watchLayerChanges(): void {
    // Watch for layer visibility changes
    const subscription = this.layers();
    // React to layer changes and show/hide layer groups
    subscription.forEach(layer => {
      const layerGroup = this.layerGroups.get(layer.id);
      if (layerGroup && this.map) {
        if (layer.visible) {
          layerGroup.addTo(this.map);
        } else {
          layerGroup.removeFrom(this.map);
        }
      }
    });
  }

  ngOnDestroy(): void {
    this.markers.forEach(marker => marker.remove());
    this.layerGroups.forEach(group => group.remove());
    
    if (this.map) {
      this.map.remove();
      this.map = null;
    }
  }
}
```

