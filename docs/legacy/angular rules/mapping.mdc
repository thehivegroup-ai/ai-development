## Layer Toggle Sidebar

```typescript
// components/map/layer-sidebar/layer-sidebar.component.ts
import { Component, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MapLayersService } from '@/services/map-layers.service';

@Component({
  selector: 'app-layer-sidebar',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './layer-sidebar.component.html',
  styleUrls: ['./layer-sidebar.component.css']
})
export class LayerSidebarComponent {
  private mapLayersService = inject(MapLayersService);
  
  layers = this.mapLayersService.layers;

  toggleLayer(layerId: string): void {
    this.mapLayersService.toggleLayer(layerId);
  }
}
```

```html
<!-- layer-sidebar.component.html -->
<aside class="w-80 bg-surface-secondary border-r border-border-default overflow-y-auto">
  <div class="p-6">
    <h2 class="text-lg font-semibold mb-4">Map Layers</h2>
    
    <div class="space-y-3">
      @for (layer of layers(); track layer.id) {
        <label class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-hover cursor-pointer">
          <input
            type="checkbox"
            [checked]="layer.visible"
            (change)="toggleLayer(layer.id)"
            class="input-checkbox"
          />
          <span class="font-medium">{{ layer.name }}</span>
        </label>
      }
    </div>
  </div>
</aside>
