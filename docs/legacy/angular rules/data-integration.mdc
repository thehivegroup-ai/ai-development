## Best Practices

### 1. Use Signals for Reactive State

```typescript
// ✅ CORRECT: Signals with computed values
private dataSignal = signal<Data[]>([]);
filteredData = computed(() => 
  this.dataSignal().filter(item => item.active)
);
```

### 2. Centralize API URLs

```typescript
// ✅ CORRECT: Centralized API configuration
import { getApiUrl } from '@/lib/api/api-config';
this.http.get(getApiUrl('/api/properties'));
```

### 3. Type All Data

```typescript
// ✅ CORRECT: TypeScript interfaces
export interface Property {
  id: string;
  address: string;
  price: number;
}

this.http.get<Property[]>(getApiUrl('/api/properties'));
```

### 4. Handle Loading and Error States

```typescript
// ✅ CORRECT: Track loading and errors
loading = signal(false);
error = signal<string | null>(null);

loadData(): void {
  this.loading.set(true);
  this.error.set(null);
  
  this.http.get('/api/data').subscribe({
    next: data => {
      // Handle data
      this.loading.set(false);
    },
    error: error => {
      this.error.set('Failed to load');
      this.loading.set(false);
    }
  });
}
```

