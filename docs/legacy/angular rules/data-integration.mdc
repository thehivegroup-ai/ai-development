# Data Integration Patterns for Angular

This rule defines patterns for fetching, caching, and synchronizing data from the Fastify backend API.

## Core Principles

1. **HttpClient**: Use Angular's HttpClient for all API calls
2. **Services**: Centralize data fetching in Injectable services
3. **RxJS**: Use Observables for asynchronous operations
4. **Signals**: Use Signals for reactive state management
5. **Error Handling**: Implement comprehensive error handling
6. **Type Safety**: Use TypeScript interfaces for all data

---

## API Client Setup

### ✅ CORRECT: HttpClient with interceptors

```typescript
// lib/api/api-config.ts
export const API_CONFIG = {
  baseUrl: process.env['API_BASE_URL'] || 'http://localhost:3001',
  timeout: 30000,
};

export function getApiUrl(endpoint: string): string {
  return `${API_CONFIG.baseUrl}${endpoint}`;
}
```

```typescript
// lib/api/http-error.interceptor.ts
import { HttpErrorResponse, HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { catchError, throwError } from 'rxjs';
import { Router } from '@angular/router';

export const httpErrorInterceptor: HttpInterceptorFn = (req, next) => {
  const router = inject(Router);

  return next(req).pipe(
    catchError((error: HttpErrorResponse) => {
      if (error.status === 401) {
        // Unauthorized - redirect to login
        router.navigate(['/login']);
      } else if (error.status === 500) {
        console.error('Server error:', error);
      }
      return throwError(() => error);
    })
  );
};
```

```typescript
// app.config.ts
import { ApplicationConfig } from '@angular/core';
import { provideHttpClient, withInterceptors } from '@angular/common/http';
import { httpErrorInterceptor } from '@/lib/api/http-error.interceptor';

export const appConfig: ApplicationConfig = {
  providers: [
    provideHttpClient(
      withInterceptors([httpErrorInterceptor])
    ),
  ]
};
