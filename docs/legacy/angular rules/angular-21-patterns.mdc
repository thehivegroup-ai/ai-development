## Angular Signals (v16+, refined in v21)

### ✅ CORRECT: Using signals for reactive state

```typescript
import { Component, signal, computed, effect } from '@angular/core';

@Component({
  selector: 'app-property-list',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold">
          Properties ({{ filteredProperties().length }})
        </h2>
        <button class="btn-primary" (click)="toggleFilter()">
          {{ showActive() ? 'Show All' : 'Show Active Only' }}
        </button>
      </div>

      @for (property of filteredProperties(); track property.id) {
        <div class="card p-4">
          <h3 class="font-semibold">{{ property.address }}</h3>
          <p class="text-sm text-text-secondary">{{ property.city }}, {{ property.state }}</p>
        </div>
      }
    </div>
  `
})
export class PropertyListComponent {
  // Writable signals
  properties = signal<Property[]>([]);
  showActive = signal(true);

  // Computed signal (derived state)
  filteredProperties = computed(() => {
    const all = this.properties();
    return this.showActive()
      ? all.filter(p => p.status === 'active')
      : all;
  });

  // Effect (side effects when signals change)
  logEffect = effect(() => {
    console.log('Filtered count:', this.filteredProperties().length);
  });

  constructor(private propertyService: PropertyService) {
    // Load data
    this.propertyService.getProperties().subscribe({
      next: (response) => {
        if (response.success && response.data) {
          this.properties.set(response.data);
        }
      }
    });
  }

  toggleFilter(): void {
    this.showActive.update(value => !value);
  }

  addProperty(property: Property): void {
    this.properties.update(list => [...list, property]);
  }
}
```

### Signal Methods:

```typescript
// Create signal
const count = signal(0);

// Read signal value
console.log(count()); // 0

// Set new value
count.set(5);

// Update based on previous value
count.update(value => value + 1);

// Computed signal (read-only, auto-updates)
const doubled = computed(() => count() * 2);

// Effect (runs when signals change)
effect(() => {
  console.log('Count is now:', count());
});
```

### ❌ WRONG: Using old Subject/BehaviorSubject pattern

```typescript
// ❌ BAD: Using BehaviorSubject (prefer signals)
import { BehaviorSubject } from 'rxjs';

export class PropertyListComponent {
  private propertiesSubject = new BehaviorSubject<Property[]>([]);
  properties$ = this.propertiesSubject.asObservable();

  addProperty(property: Property) {
    const current = this.propertiesSubject.value;
    this.propertiesSubject.next([...current, property]);
  }
}
// Use signals instead for local state!
```

