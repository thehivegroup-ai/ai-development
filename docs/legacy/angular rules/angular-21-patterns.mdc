## Angular v21: Standalone Components

### ✅ CORRECT: Standalone component (default in v21)

```typescript
// property-form.component.ts
import { Component, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ReactiveFormsModule, FormGroup, FormControl, Validators } from '@angular/forms';
import { Router, RouterLink } from '@angular/router';

interface PropertyFormData {
  address: string;
  city: string;
  state: string;
  squareFootage: number;
  pumpCount: number;
}

@Component({
  selector: 'app-property-form',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, RouterLink],
  templateUrl: './property-form.component.html',
  styleUrls: ['./property-form.component.css']
})
export class PropertyFormComponent {
  isPending = signal(false);
  errorMessage = signal<string | null>(null);

  form = new FormGroup({
    address: new FormControl('', { validators: [Validators.required], nonNullable: true }),
    city: new FormControl('', { validators: [Validators.required], nonNullable: true }),
    state: new FormControl('', { validators: [Validators.required, Validators.maxLength(2)], nonNullable: true }),
    squareFootage: new FormControl(0, { validators: [Validators.required, Validators.min(2000)], nonNullable: true }),
    pumpCount: new FormControl(0, { validators: [Validators.required, Validators.min(4)], nonNullable: true }),
  });

  constructor(
    private router: Router,
    private propertyService: PropertyService
  ) {}

  onSubmit(): void {
    if (this.form.invalid) {
      return;
    }

    this.isPending.set(true);
    this.errorMessage.set(null);

    const formData = this.form.getRawValue();

    this.propertyService.createProperty(formData).subscribe({
      next: (response) => {
        this.isPending.set(false);
        if (response.success && response.data) {
          this.router.navigate(['/properties', response.data.id]);
        }
      },
      error: (error) => {
        this.isPending.set(false);
        this.errorMessage.set('Failed to create property');
      }
    });
  }
}
```

