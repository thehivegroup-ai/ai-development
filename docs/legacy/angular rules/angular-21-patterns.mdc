## RxJS Integration

### ✅ CORRECT: Using RxJS for async operations

```typescript
import { Component, OnInit, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { map, catchError, of, debounceTime, distinctUntilChanged } from 'rxjs';
import { FormControl, ReactiveFormsModule } from '@angular/forms';

@Component({
  selector: 'app-property-search',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  template: `
    <div class="space-y-4">
      <input
        type="text"
        [formControl]="searchControl"
        placeholder="Search properties..."
        class="input-search"
      />

      @if (isLoading()) {
        <div class="spinner">Searching...</div>
      }

      @for (property of results(); track property.id) {
        <div class="card p-4">
          <h3>{{ property.address }}</h3>
        </div>
      } @empty {
        <p class="text-text-secondary">No results found</p>
      }
    </div>
  `
})
export class PropertySearchComponent implements OnInit {
  searchControl = new FormControl('', { nonNullable: true });
  results = signal<Property[]>([]);
  isLoading = signal(false);

  constructor(private propertyService: PropertyService) {}

  ngOnInit(): void {
    // Reactive search with debounce
    this.searchControl.valueChanges.pipe(
      debounceTime(300),
      distinctUntilChanged(),
    ).subscribe(query => {
      if (query.length < 2) {
        this.results.set([]);
        return;
      }

      this.isLoading.set(true);
      this.propertyService.searchProperties(query).pipe(
        map(response => response.data || []),
        catchError(() => {
          this.isLoading.set(false);
          return of([]);
        })
      ).subscribe(properties => {
        this.isLoading.set(false);
        this.results.set(properties);
      });
    });
  }
}
```

