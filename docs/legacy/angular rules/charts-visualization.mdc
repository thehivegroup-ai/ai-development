## Chart Component Patterns

### Waterfall Chart (Cash Flow)

```typescript
// components/charts/cash-flow-waterfall-chart/cash-flow-waterfall-chart.component.ts
import { Component, Input, OnInit, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration } from 'chart.js';
import { CHART_COLORS, formatCurrency } from '@/lib/charts/config';

interface CashFlowData {
  label: string;
  value: number;
  isTotal?: boolean;
}

@Component({
  selector: 'app-cash-flow-waterfall-chart',
  standalone: true,
  imports: [CommonModule, BaseChartDirective],
  templateUrl: './cash-flow-waterfall-chart.component.html',
  styleUrls: ['./cash-flow-waterfall-chart.component.css']
})
export class CashFlowWaterfallChartComponent implements OnInit {
  @Input() set data(value: CashFlowData[]) {
    this.dataSignal.set(value);
  }

  private dataSignal = signal<CashFlowData[]>([]);
  
  chartData = computed(() => {
    const data = this.dataSignal();
    let runningTotal = 0;
    const starts: (number | null)[] = [];
    const values: (number | null)[] = [];
    const totals: (number | null)[] = [];
    
    data.forEach((item, index) => {
      if (item.isTotal) {
        starts.push(null);
        values.push(null);
        totals.push(runningTotal);
      } else {
        starts.push(runningTotal);
        values.push(item.value);
        totals.push(null);
        runningTotal += item.value;
      }
    });

    return {
      labels: data.map(d => d.label),
      datasets: [
        {
          label: 'Start',
          data: starts,
          backgroundColor: 'transparent',
          borderColor: 'transparent',
        },
        {
          label: 'Increase',
          data: values.map(v => (v && v > 0) ? v : null),
          backgroundColor: CHART_COLORS.success,
          stack: 'stack1',
        },
        {
          label: 'Decrease',
          data: values.map(v => (v && v < 0) ? Math.abs(v) : null),
          backgroundColor: CHART_COLORS.danger,
          stack: 'stack1',
        },
        {
          label: 'Total',
          data: totals,
          backgroundColor: CHART_COLORS.primary,
        },
      ],
    };
  });

  chartOptions: ChartConfiguration['options'] = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        display: true,
        position: 'bottom',
      },
      tooltip: {
        callbacks: {
          label: (context) => {
            return `${context.dataset.label}: ${formatCurrency(context.parsed.y)}`;
          },
        },
      },
    },
    scales: {
      x: {
        stacked: true,
        grid: {
          display: false,
        },
      },
      y: {
        stacked: true,
        ticks: {
          callback: (value) => formatCurrency(value as number),
        },
      },
    },
  };

  chartType: ChartConfiguration['type'] = 'bar';

  ngOnInit() {
    // Component initialization if needed
  }
}
```

```html
<!-- cash-flow-waterfall-chart.component.html -->
<div class="card p-6 space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold">Annual Cash Flow</h3>
  </div>

  <div class="h-[400px]">
    <canvas
      baseChart
      [data]="chartData()"
      [options]="chartOptions"
      [type]="chartType">
    </canvas>
  </div>

  <div class="flex items-center gap-4 flex-wrap">
    @for (item of legendItems; track item.label) {
      <div class="flex items-center gap-2">
        <div
          class="w-3 h-3 rounded"
          [style.background-color]="item.color">
        </div>
        <span class="text-sm text-text-secondary">{{ item.label }}</span>
      </div>
    }
  </div>
</div>
```

### Scatter Chart (Network Analysis)

```typescript
// components/charts/network-analysis-scatter-chart/network-analysis-scatter-chart.component.ts
import { Component, Input, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration } from 'chart.js';
import { CHART_COLORS, formatNumber, formatCurrency } from '@/lib/charts/config';

interface SiteDataPoint {
  siteId: string;
  siteName: string;
  gallons: number;
  margin: number;
  isNewSite?: boolean;
}

@Component({
  selector: 'app-network-analysis-scatter-chart',
  standalone: true,
  imports: [CommonModule, BaseChartDirective],
  templateUrl: './network-analysis-scatter-chart.component.html',
  styleUrls: ['./network-analysis-scatter-chart.component.css']
})
export class NetworkAnalysisScatterChartComponent {
  @Input() set data(value: SiteDataPoint[]) {
    this.dataSignal.set(value);
  }

  private dataSignal = signal<SiteDataPoint[]>([]);

  chartData = computed(() => {
    const data = this.dataSignal();
    const existingSites = data.filter(d => !d.isNewSite);
    const newSites = data.filter(d => d.isNewSite);

    return {
      datasets: [
        {
          label: 'Existing Stores',
          data: existingSites.map(d => ({ x: d.gallons, y: d.margin })),
          backgroundColor: 'rgba(156, 163, 175, 0.5)',
          borderColor: 'rgb(156, 163, 175)',
          pointRadius: 6,
          pointHoverRadius: 8,
        },
        {
          label: 'New Site',
          data: newSites.map(d => ({ x: d.gallons, y: d.margin })),
          backgroundColor: CHART_COLORS.primary,
          borderColor: CHART_COLORS.primary,
          pointRadius: 8,
          pointHoverRadius: 10,
        },
      ],
    };
  });

  chartOptions: ChartConfiguration['options'] = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        display: true,
        position: 'bottom',
      },
      tooltip: {
        callbacks: {
          label: (context) => {
            const point = context.raw as { x: number; y: number };
            return [
              `Gallons: ${formatNumber(point.x)}`,
              `Margin: ${formatCurrency(point.y)}`,
            ];
          },
        },
      },
    },
    scales: {
      x: {
        title: {
          display: true,
          text: 'Annual Gallons',
        },
        ticks: {
          callback: (value) => formatNumber(value as number),
        },
      },
      y: {
        title: {
          display: true,
          text: 'Fuel Margin ($)',
        },
        ticks: {
          callback: (value) => formatCurrency(value as number),
        },
      },
    },
  };

  chartType: ChartConfiguration['type'] = 'scatter';
}
```

```html
<!-- network-analysis-scatter-chart.component.html -->
