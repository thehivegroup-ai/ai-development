## Best Practices

### 1. Use Signals for Reactive Data

```typescript
// ✅ CORRECT: Using signals
export class ChartComponent {
  private dataSignal = signal<ChartData[]>([]);
  
  chartData = computed(() => {
    return this.transformData(this.dataSignal());
  });
}
```

```typescript
// ❌ WRONG: Manual change detection
export class ChartComponent {
  private _data: ChartData[] = [];
  
  @Input() set data(value: ChartData[]) {
    this._data = value;
    this.updateChart(); // Manual update
  }
}
```

### 2. Use OnPush Change Detection

```typescript
// ✅ CORRECT: OnPush for performance
@Component({
  selector: 'app-chart',
  changeDetection: ChangeDetectionStrategy.OnPush,
  // ...
})
export class ChartComponent { }
```

### 3. Format Data with Pure Functions

```typescript
// ✅ CORRECT: Pure formatting functions
export class ChartComponent {
  formatCurrency = formatCurrency;
  formatNumber = formatNumber;
  formatPercent = formatPercent;
}
```

### 4. Responsive Charts

```html
<!-- ✅ CORRECT: Fixed height container -->
<div class="h-[400px]">
  <canvas baseChart [data]="chartData()"></canvas>
</div>
```

```css
/* Component styles for responsive behavior */
:host {
  display: block;
  width: 100%;
}
```

### 5. Accessibility

```html
<!-- ✅ CORRECT: Accessible chart -->
<div class="card p-6" role="region" aria-label="Revenue projection chart">
  <h3 id="chart-title" class="text-lg font-semibold">Revenue Projection</h3>
  <div class="h-[400px]">
    <canvas
      baseChart
      [data]="chartData()"
      [aria-labelledby]="'chart-title'"
      role="img">
    </canvas>
  </div>
  
  <!-- Data table for screen readers -->
  <table class="sr-only">
    <caption>Revenue projection data</caption>
    <!-- Table data -->
  </table>
</div>
```

