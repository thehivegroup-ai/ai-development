### Pie/Doughnut Chart (Expense Breakdown)

```typescript
// components/charts/expense-breakdown-chart/expense-breakdown-chart.component.ts
import { Component, Input, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { BaseChartDirective } from 'ng2-charts';
import { ChartConfiguration } from 'chart.js';
import { CHART_COLORS, formatCurrency, formatPercent } from '@/lib/charts/config';

interface ExpenseCategory {
  category: string;
  amount: number;
  color: string;
}

@Component({
  selector: 'app-expense-breakdown-chart',
  standalone: true,
  imports: [CommonModule, BaseChartDirective],
  templateUrl: './expense-breakdown-chart.component.html',
  styleUrls: ['./expense-breakdown-chart.component.css']
})
export class ExpenseBreakdownChartComponent {
  @Input() set data(value: ExpenseCategory[]) {
    this.dataSignal.set(value);
  }

  private dataSignal = signal<ExpenseCategory[]>([]);

  total = computed(() => {
    return this.dataSignal().reduce((sum, item) => sum + item.amount, 0);
  });

  chartData = computed(() => {
    const data = this.dataSignal();
    return {
      labels: data.map(d => d.category),
      datasets: [
        {
          data: data.map(d => d.amount),
          backgroundColor: data.map(d => d.color),
          borderWidth: 2,
          borderColor: '#FFFFFF',
        },
      ],
    };
  });

  tableData = computed(() => {
    const data = this.dataSignal();
    const total = this.total();
    return data.map(item => ({
      ...item,
      percentage: item.amount / total,
    }));
  });

  chartOptions: ChartConfiguration['options'] = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        display: true,
        position: 'right',
      },
      tooltip: {
        callbacks: {
          label: (context) => {
            const value = context.parsed as number;
            const total = (context.dataset.data as number[]).reduce((a, b) => a + b, 0);
            const percentage = (value / total) * 100;
            return `${context.label}: ${formatCurrency(value)} (${percentage.toFixed(1)}%)`;
          },
        },
      },
    },
  };

  chartType: ChartConfiguration['type'] = 'doughnut';
}
```

```html
<!-- expense-breakdown-chart.component.html -->
<div class="card p-6 space-y-4">
  <h3 class="text-lg font-semibold">Operating Expense Breakdown</h3>

  <div class="h-[300px]">
    <canvas
      baseChart
      [data]="chartData()"
      [options]="chartOptions"
      [type]="chartType">
    </canvas>
  </div>

  <div class="border-t pt-4">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-text-secondary">
          <th class="pb-2">Category</th>
          <th class="pb-2 text-right">Amount</th>
          <th class="pb-2 text-right">% of Total</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        @for (item of tableData(); track item.category) {
          <tr>
            <td class="py-2 flex items-center gap-2">
              <div
                class="w-3 h-3 rounded"
                [style.background-color]="item.color">
              </div>
              <span class="text-sm font-semibold">{{ item.category }}</span>
            </td>
            <td class="py-2 text-right font-medium">
              {{ formatCurrency(item.amount) }}
            </td>
            <td class="py-2 text-right text-text-secondary">
              {{ formatPercent(item.percentage) }}
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
```

