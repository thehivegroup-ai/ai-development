# Charts & Visualization Patterns for Angular

This rule defines patterns for creating financial charts, graphs, and data visualizations in the Report section and throughout the Angular application.

## Core Principles

1. **ng2-charts or Chart.js**: Primary charting library for Angular (TypeScript-friendly)
2. **Responsive**: Charts must adapt to container size
3. **Accessible**: Include proper labels, legends, and ARIA attributes
4. **Type-Safe**: Define data interfaces for all charts
5. **Performance**: Use OnPush change detection and Angular Signals

---

## Chart Library Setup

### ✅ CORRECT: Chart.js with Angular integration

```bash
npm install chart.js ng2-charts
```

```typescript
// lib/charts/config.ts

export const CHART_COLORS = {
  primary: '#C41F1D',        // Brand red
  secondary: '#FF6B00',      // Orange
  success: '#10B981',        // Green
  warning: '#F59E0B',        // Yellow
  danger: '#EF4444',         // Red
  info: '#3B82F6',           // Blue
  neutral: '#6B7280',        // Gray
} as const;

export const CHART_DEFAULTS = {
  font: {
    family: 'ui-sans-serif, system-ui, sans-serif',
    size: 12,
  },
  plugins: {
    legend: {
      position: 'bottom' as const,
      labels: {
        usePointStyle: true,
        padding: 16,
      },
    },
    tooltip: {
      backgroundColor: '#FFFFFF',
      titleColor: '#1F2937',
      bodyColor: '#4B5563',
      borderColor: '#E5E7EB',
      borderWidth: 1,
      padding: 12,
      displayColors: true,
    },
  },
  responsive: true,
  maintainAspectRatio: false,
};

export function formatCurrency(value: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(value);
}

export function formatNumber(value: number): string {
  return new Intl.NumberFormat('en-US').format(value);
}

export function formatPercent(value: number): string {
  return `${(value * 100).toFixed(1)}%`;
}
