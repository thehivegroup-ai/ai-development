## Component Integration

### ✅ CORRECT: Proforma calculator component

```typescript
// features/proforma/proforma-calculator/proforma-calculator.component.ts
import { Component, inject, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { ProformaService } from '@/services/proforma.service';
import { formatCurrency, formatPercentage } from '@/lib/calculations/financial';

@Component({
  selector: 'app-proforma-calculator',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './proforma-calculator.component.html',
})
export class ProformaCalculatorComponent {
  private fb = inject(FormBuilder);
  private proformaService = inject(ProformaService);

  form = this.fb.group({
    landCost: [0, [Validators.required, Validators.min(0)]],
    constructionCost: [0, [Validators.required, Validators.min(0)]],
    fuelGallons: [0, [Validators.required, Validators.min(0)]],
    fuelMargin: [0, [Validators.required, Validators.min(0)]],
    inStoreRevenue: [0, [Validators.required, Validators.min(0)]],
    inStoreMargin: [0, [Validators.required, Validators.min(0)]],
    labor: [0, [Validators.required, Validators.min(0)]],
    utilities: [0, [Validators.required, Validators.min(0)]],
    maintenance: [0, [Validators.required, Validators.min(0)]],
    insurance: [0, [Validators.required, Validators.min(0)]],
    discountRate: [0.1, [Validators.required, Validators.min(0), Validators.max(1)]],
    projectYears: [10, [Validators.required, Validators.min(1)]],
  });

  results = this.proformaService.results;

  // Formatted display values
  formattedInvestment = computed(() => 
    formatCurrency(this.results().totalInvestment)
  );
  
  formattedRevenue = computed(() => 
    formatCurrency(this.results().annualRevenue)
  );
  
  formattedNPV = computed(() => 
    formatCurrency(this.results().npv)
  );
  
  formattedIRR = computed(() => {
    const irr = this.results().irr;
    return irr !== null ? formatPercentage(irr) : 'N/A';
  });

  isPositiveNPV = computed(() => this.results().npv > 0);

  constructor() {
    // Subscribe to form changes and update service
    this.form.valueChanges.subscribe(values => {
      if (this.form.valid) {
        this.proformaService.updateInputs(values as any);
      }
    });
  }

  handleCalculate(): void {
    if (this.form.valid) {
      this.proformaService.updateInputs(this.form.value as any);
    }
  }

  handleReset(): void {
    this.form.reset({
      landCost: 0,
      constructionCost: 0,
      fuelGallons: 0,
      fuelMargin: 0,
      inStoreRevenue: 0,
      inStoreMargin: 0,
      labor: 0,
      utilities: 0,
      maintenance: 0,
      insurance: 0,
      discountRate: 0.1,
      projectYears: 10,
    });
    this.proformaService.resetInputs();
  }
}
```

