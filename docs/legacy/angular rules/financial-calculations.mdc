## Unit Testing

### ✅ CORRECT: Test financial functions

```typescript
// lib/calculations/financial.spec.ts
import { calculateNPV, calculateIRR, calculateMortgagePayment, roundToPrecision } from './financial';

describe('Financial Calculations', () => {
  describe('calculateNPV', () => {
    it('should calculate NPV correctly', () => {
      const cashFlows = [-1000, 300, 300, 300, 300];
      const discountRate = 0.1;
      const npv = calculateNPV(cashFlows, discountRate);
      expect(npv).toBeCloseTo(51.89, 2);
    });

    it('should handle zero discount rate', () => {
      const cashFlows = [-1000, 300, 300, 300, 300];
      const npv = calculateNPV(cashFlows, 0);
      expect(npv).toBe(200); // Sum of all cash flows
    });
  });

  describe('calculateIRR', () => {
    it('should calculate IRR correctly', () => {
      const cashFlows = [-1000, 300, 300, 300, 300];
      const irr = calculateIRR(cashFlows);
      expect(irr).toBeCloseTo(0.076, 3);
    });

    it('should return null if no convergence', () => {
      const cashFlows = [-1000, -100, -100];
      const irr = calculateIRR(cashFlows);
      expect(irr).toBeNull();
    });
  });

  describe('calculateMortgagePayment', () => {
    it('should calculate monthly payment correctly', () => {
      const payment = calculateMortgagePayment(200000, 0.05, 30);
      expect(payment).toBeCloseTo(1073.64, 2);
    });
  });

  describe('roundToPrecision', () => {
    it('should round to 2 decimals by default', () => {
      expect(roundToPrecision(1.2345)).toBe(1.23);
    });

    it('should round to specified decimals', () => {
      expect(roundToPrecision(1.2345, 3)).toBe(1.235);
    });
  });
});
```

