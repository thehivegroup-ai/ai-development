## Best Practices

### 1. Use Pure Functions

```typescript
// ✅ CORRECT: Pure calculation function
export function calculateNPV(cashFlows: number[], rate: number): number {
  return cashFlows.reduce((npv, cf, period) => 
    npv + cf / Math.pow(1 + rate, period), 0
  );
}
```

### 2. Handle Precision

```typescript
// ✅ CORRECT: Round to avoid floating point errors
export function roundToPrecision(value: number, decimals: number = 2): number {
  return Math.round(value * Math.pow(10, decimals)) / Math.pow(10, decimals);
}
```

### 3. Use Computed Signals

```typescript
// ✅ CORRECT: Reactive calculations with computed
totalCost = computed(() => 
  roundToPrecision(this.landCost() + this.constructionCost())
);
```

### 4. Format for Display

```typescript
// ✅ CORRECT: Format currency and percentages
formattedValue = computed(() => formatCurrency(this.value()));
```

