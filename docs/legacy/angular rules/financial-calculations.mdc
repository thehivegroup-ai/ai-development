## Proforma Model Service

### ✅ CORRECT: Proforma calculations with Signals

```typescript
// services/proforma.service.ts
import { Injectable, signal, computed } from '@angular/core';
import {
  calculateNPV,
  calculateIRR,
  calculateMortgagePayment,
  roundToPrecision
} from '@/lib/calculations/financial';

export interface ProformaInputs {
  // Construction
  landCost: number;
  constructionCost: number;
  
  // Revenue
  fuelGallons: number;
  fuelMargin: number;
  inStoreRevenue: number;
  inStoreMargin: number;
  
  // Expenses
  labor: number;
  utilities: number;
  maintenance: number;
  insurance: number;
  
  // Financial
  discountRate: number;
  projectYears: number;
}

export interface ProformaResults {
  totalInvestment: number;
  annualRevenue: number;
  annualExpenses: number;
  annualCashFlow: number;
  npv: number;
  irr: number | null;
  paybackPeriod: number | null;
}

@Injectable({
  providedIn: 'root'
})
export class ProformaService {
  // Input signals
  private inputsSignal = signal<ProformaInputs>({
    landCost: 0,
    constructionCost: 0,
    fuelGallons: 0,
    fuelMargin: 0,
    inStoreRevenue: 0,
    inStoreMargin: 0,
    labor: 0,
    utilities: 0,
    maintenance: 0,
    insurance: 0,
    discountRate: 0.1,
    projectYears: 10,
  });

  inputs = this.inputsSignal.asReadonly();

  // Computed calculations
  totalInvestment = computed(() => {
    const inputs = this.inputs();
    return roundToPrecision(inputs.landCost + inputs.constructionCost);
  });

  annualFuelRevenue = computed(() => {
    const inputs = this.inputs();
    return roundToPrecision(inputs.fuelGallons * inputs.fuelMargin);
  });

  annualInStoreRevenue = computed(() => {
    const inputs = this.inputs();
    return roundToPrecision(inputs.inStoreRevenue * inputs.inStoreMargin);
  });

  annualRevenue = computed(() => {
    return roundToPrecision(
      this.annualFuelRevenue() + this.annualInStoreRevenue()
    );
  });

  annualExpenses = computed(() => {
    const inputs = this.inputs();
    return roundToPrecision(
      inputs.labor + 
      inputs.utilities + 
      inputs.maintenance + 
      inputs.insurance
    );
  });

  annualCashFlow = computed(() => {
    return roundToPrecision(
      this.annualRevenue() - this.annualExpenses()
    );
  });

  cashFlows = computed(() => {
    const investment = this.totalInvestment();
    const annualCashFlow = this.annualCashFlow();
    const years = this.inputs().projectYears;
    
    // Year 0: negative (investment)
    // Years 1-N: positive (cash flow)
    return [-investment, ...Array(years).fill(annualCashFlow)];
  });

  npv = computed(() => {
    const cashFlows = this.cashFlows();
    const discountRate = this.inputs().discountRate;
    return roundToPrecision(calculateNPV(cashFlows, discountRate));
  });

  irr = computed(() => {
    const cashFlows = this.cashFlows();
    const irrValue = calculateIRR(cashFlows);
    return irrValue !== null ? roundToPrecision(irrValue, 4) : null;
  });

  paybackPeriod = computed(() => {
    const investment = this.totalInvestment();
    const annualCashFlow = this.annualCashFlow();
    
    if (annualCashFlow <= 0) return null;
    
    return roundToPrecision(investment / annualCashFlow, 1);
  });

  results = computed((): ProformaResults => ({
    totalInvestment: this.totalInvestment(),
    annualRevenue: this.annualRevenue(),
    annualExpenses: this.annualExpenses(),
    annualCashFlow: this.annualCashFlow(),
    npv: this.npv(),
    irr: this.irr(),
    paybackPeriod: this.paybackPeriod(),
  }));

  // Methods to update inputs
  updateInputs(updates: Partial<ProformaInputs>): void {
    this.inputsSignal.update(current => ({ ...current, ...updates }));
  }

  resetInputs(): void {
    this.inputsSignal.set({
      landCost: 0,
      constructionCost: 0,
      fuelGallons: 0,
      fuelMargin: 0,
      inStoreRevenue: 0,
      inStoreMargin: 0,
      labor: 0,
      utilities: 0,
      maintenance: 0,
      insurance: 0,
      discountRate: 0.1,
      projectYears: 10,
    });
  }
}
```

