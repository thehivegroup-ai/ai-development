## Tailwind 4.1 New Features

### Container Queries

```typescript
// ✅ CORRECT: Use container queries for responsive components
import { Component, Input } from '@angular/core';

@Component({
  selector: 'app-property-card',
  standalone: true,
  template: `
    <div class="card p-6 @container"> <!-- Enable container queries -->
      <h3 class="text-xl @lg:text-2xl font-semibold"> <!-- Responsive to container -->
        {{ property.address }}
      </h3>
      
      <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
        <!-- Responsive based on container width, not viewport -->
        <app-metric-display label="Square Footage" [value]="property.squareFootage" />
        <app-metric-display label="Pump Count" [value]="property.pumpCount" />
      </div>
    </div>
  `
})
export class PropertyCardComponent {
  @Input() property!: Property;
}
```

### Native CSS Nesting

```css
/* Tailwind 4.1 supports native CSS nesting */
.card-hover {
  @apply card transition-shadow duration-200;
  
  &:hover {
    @apply shadow-md;
    
    .card-title {
      @apply text-brand-red-600;
    }
  }
}
```

### Arbitrary Variants

```html
<!-- ✅ CORRECT: Use arbitrary variants for complex conditions -->
<div class="group">
  <h3 class="group-hover:text-brand-red-600">Title</h3>
  <button class="group-[&:has(:focus-visible)]:ring-2">
    Button
  </button>
</div>

<!-- Supports complex selectors -->
<div class="[&>p]:my-4 [&>ul]:ml-6">
  <!-- All direct <p> children get my-4, all <ul> get ml-6 -->
  <p>Paragraph with my-4</p>
  <ul>List with ml-6</ul>
</div>
```

