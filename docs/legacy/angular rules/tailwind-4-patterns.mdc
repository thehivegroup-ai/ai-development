## Angular-Specific Patterns

### Dynamic Classes with [ngClass]

```typescript
import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-button',
  standalone: true,
  imports: [CommonModule],
  template: `
    <!-- Using [ngClass] with object syntax -->
    <button [ngClass]="{
      'btn-primary': variant === 'primary',
      'btn-secondary': variant === 'secondary',
      'btn-ghost': variant === 'ghost',
      'opacity-50': disabled,
      'cursor-not-allowed': disabled
    }">
      <ng-content></ng-content>
    </button>

    <!-- Using [class] with string interpolation -->
    <button [class]="buttonClass + ' ' + (disabled ? 'opacity-50' : '')">
      <ng-content></ng-content>
    </button>

    <!-- Using [ngClass] with array syntax -->
    <button [ngClass]="['btn-primary', disabled ? 'opacity-50' : '']">
      <ng-content></ng-content>
    </button>
  `
})
export class ButtonComponent {
  @Input() variant: 'primary' | 'secondary' | 'ghost' = 'primary';
  @Input() disabled = false;

  get buttonClass(): string {
    const variantClasses = {
      primary: 'btn-primary',
      secondary: 'btn-secondary',
      ghost: 'btn-ghost',
    };
    return variantClasses[this.variant];
  }
}
```

### Component-Scoped Styles with :host

```typescript
// property-card.component.ts
import { Component, Input } from '@angular/core';

@Component({
  selector: 'app-property-card',
  standalone: true,
  templateUrl: './property-card.component.html',
  styleUrls: ['./property-card.component.css'],
  // ViewEncapsulation.Emulated is default (scoped styles)
})
export class PropertyCardComponent {
  @Input() property!: Property;
}
```

```css
/* property-card.component.css */
/* Style the host element itself */
:host {
  @apply block; /* Make component display: block */
}

:host(.featured) {
  @apply ring-2 ring-brand-red-600; /* When component has 'featured' class */
}

/* Scoped to this component */
.card-title {
  @apply text-xl font-semibold;
}

/* Using @apply with Tailwind */
.property-info {
  @apply grid grid-cols-2 gap-4;
}
```

```html
<!-- property-card.component.html -->
<div class="card p-6">
  <h3 class="card-title">{{ property.address }}</h3>
  <div class="property-info">
    <!-- Component-scoped styles -->
  </div>
</div>
```

### Global Styles vs Component Styles

**Global styles** (`src/styles.css`):
```css
/* Global component classes available everywhere */
@layer components {
  .btn-primary { /* ... */ }
  .card { /* ... */ }
  .input { /* ... */ }
}
```

**Component styles** (`*.component.css`):
```css
/* Scoped to component only */
:host {
  @apply block;
}

.internal-class {
  @apply p-4 bg-gray-50;
}
```

