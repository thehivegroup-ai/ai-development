## Component Architecture: Three Layers

### Layer 1: Utility Classes (Layout & Spacing)

```typescript
// ✅ CORRECT: Use utilities for layout, spacing, responsive design
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-dashboard',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="container mx-auto py-8 space-y-8"> <!-- Utilities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"> <!-- Utilities -->
        <app-metric-card />
        <app-metric-card />
        <app-metric-card />
      </div>
    </div>
  `
})
export class DashboardComponent {}
```

### Layer 2: Control CSS Classes (Reusable Styles)

```typescript
// ✅ CORRECT: Use CSS classes for controls
import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

interface FormFieldProps {
  label: string;
  error?: string;
}

@Component({
  selector: 'app-form-field',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="space-y-2"> <!-- Utility: spacing -->
      <label class="label"> <!-- CSS class: control -->
        {{ label }}
      </label>
      <ng-content></ng-content>
      @if (error) {
        <p class="text-sm text-red-600">{{ error }}</p> <!-- Utilities: text styling -->
      }
    </div>
  `
})
export class FormFieldComponent {
  @Input() label!: string;
  @Input() error?: string;
}
```

```html
<!-- Usage -->
<app-form-field label="Address" [error]="errors.address">
  <input type="text" class="input" /> <!-- CSS class: control -->
</app-form-field>
```

### Layer 3: Components (Composed from Controls + Utilities)

```typescript
// ✅ CORRECT: Components use both CSS classes and utilities
import { Component, Input } from '@angular/core';
import { CommonModule } from '@angular/common';

interface PropertyCardProps {
  property: Property;
}

@Component({
  selector: 'app-property-card',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="card p-6 space-y-4"> <!-- CSS class + utilities -->
      <h3 class="text-xl font-semibold">{{ property.address }}</h3>
      
      <div class="grid grid-cols-2 gap-4"> <!-- Utilities: layout -->
        <div>
          <p class="text-sm text-text-secondary">Square Footage</p>
          <p class="font-medium">{{ property.squareFootage | number }}</p>
        </div>
        <div>
          <p class="text-sm text-text-secondary">Pump Count</p>
          <p class="font-medium">{{ property.pumpCount }}</p>
        </div>
      </div>

      <div class="flex justify-end gap-4"> <!-- Utilities: layout -->
        <button class="btn-secondary">Edit</button> <!-- CSS class -->
        <button class="btn-primary">View Details</button> <!-- CSS class -->
      </div>
    </div>
  `
})
export class PropertyCardComponent {
  @Input() property!: Property;
}
```

### ❌ WRONG: Mixing all three layers incorrectly

```html
<!-- ❌ BAD: All inline utilities (no CSS classes for controls) -->
<button class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-brand-red-600 text-white font-semibold hover:bg-brand-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red-600 transition-colors duration-200">
  Submit
</button>
<!-- Should use: class="btn-primary" -->
```

```css
/* ❌ BAD: CSS class for layout */
.property-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
/* Should use: class="grid grid-cols-3 gap-6" */
```

