# Complex Form Patterns for Angular

This rule defines patterns for building the multi-step Build section forms with real-time validation and calculation updates using Angular Reactive Forms.

## Core Principles

1. **Angular Reactive Forms**: Form state management with type safety
2. **Custom Validators**: Schema-based validation functions
3. **Type Safety**: Forms must be fully typed
4. **Real-Time Updates**: Calculate as user types with Signals
5. **Multi-Step**: Navigate between form sections with Router

---

## Form State Management

### ✅ CORRECT: Typed Reactive Forms with Custom Validators

```typescript
// lib/validation/site-attributes.validators.ts
import { AbstractControl, ValidationErrors, ValidatorFn } from '@angular/forms';

export const STORE_STYLES = ['Standard', 'Large Format', 'Compact', 'BonFire', 'Adventure First Stop'] as const;
export const MENU_TYPES = ['Full Service', 'Limited Menu', 'Grab & Go'] as const;

export type StoreStyle = typeof STORE_STYLES[number];
export type MenuType = typeof MENU_TYPES[number];

export function minValue(min: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    if (control.value == null) return null;
    return control.value < min ? { min: { min, actual: control.value } } : null;
  };
}

export function maxValue(max: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    if (control.value == null) return null;
    return control.value > max ? { max: { max, actual: control.value } } : null;
  };
}

export function rangeValidator(min: number, max: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    if (control.value == null) return null;
    if (control.value < min) return { min: { min, actual: control.value } };
    if (control.value > max) return { max: { max, actual: control.value } };
    return null;
  };
}
```

