## Multi-Step Form Navigation

### Form State Service

```typescript
// services/proforma.service.ts
import { Injectable, signal } from '@angular/core';

export interface SiteAttributesData {
  targetLocation: string;
  address: string;
  storeStyle: string;
  pumpCount: number;
  menu: string;
  squareFootage: number;
  features: {
    catScales: boolean;
    evCharging: boolean;
    highFlow: boolean;
    lottery: boolean;
  };
}

@Injectable({
  providedIn: 'root'
})
export class ProformaService {
  private siteAttributesSignal = signal<SiteAttributesData | null>(null);
  
  siteAttributes = this.siteAttributesSignal.asReadonly();

  getSiteAttributes(): SiteAttributesData | null {
    return this.siteAttributesSignal();
  }

  updateSiteAttributes(data: SiteAttributesData): void {
    this.siteAttributesSignal.set(data);
  }

  // Save to backend
  async saveToBackend(): Promise<void> {
    const data = this.siteAttributesSignal();
    if (!data) return;

    // Call API
    // await this.http.post('/api/proforma', data).toPromise();
  }
}
