// features/build/site-attributes/site-attributes.component.ts
import { Component, OnInit, signal, computed, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ReactiveFormsModule, FormGroup, FormControl, Validators, NonNullableFormBuilder } from '@angular/forms';
import { Router, RouterLink } from '@angular/router';
import { rangeValidator, STORE_STYLES, MENU_TYPES, StoreStyle, MenuType } from '@/lib/validation/site-attributes.validators';
import { ProformaService } from '@/services/proforma.service';

interface SiteAttributesForm {
  targetLocation: FormControl<string>;
  address: FormControl<string>;
  storeStyle: FormControl<StoreStyle>;
  pumpCount: FormControl<number>;
  menu: FormControl<MenuType>;
  squareFootage: FormControl<number>;
  features: FormGroup<{
    catScales: FormControl<boolean>;
    evCharging: FormControl<boolean>;
    highFlow: FormControl<boolean>;
    lottery: FormControl<boolean>;
  }>;
}

@Component({
  selector: 'app-site-attributes',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, RouterLink],
  templateUrl: './site-attributes.component.html',
  styleUrls: ['./site-attributes.component.css']
})
export class SiteAttributesComponent implements OnInit {
  private fb = inject(NonNullableFormBuilder);
  private router = inject(Router);
  private proformaService = inject(ProformaService);

  readonly storeStyles = STORE_STYLES;
  readonly menuTypes = MENU_TYPES;

  form = this.fb.group<SiteAttributesForm>({
    targetLocation: this.fb.control('', [Validators.required]),
    address: this.fb.control('', [Validators.required]),
    storeStyle: this.fb.control<StoreStyle>('Standard', [Validators.required]),
    pumpCount: this.fb.control(16, [
      Validators.required,
      rangeValidator(4, 32)
    ]),
    menu: this.fb.control<MenuType>('Full Service', [Validators.required]),
    squareFootage: this.fb.control(5000, [
      Validators.required,
      rangeValidator(2000, 10000)
    ]),
    features: this.fb.group({
      catScales: this.fb.control(false),
      evCharging: this.fb.control(false),
      highFlow: this.fb.control(false),
      lottery: this.fb.control(true),
    })
  });

  // Real-time value tracking with signals
  pumpCount = signal(16);
  squareFootage = signal(5000);

  // Computed values for real-time calculations
  estimatedCost = computed(() => {
    const baseCost = 2000000;
    const pumpCost = this.pumpCount() * 50000;
    const sqftCost = this.squareFootage() * 200;
    return baseCost + pumpCost + sqftCost;
  });

  ngOnInit(): void {
    // Subscribe to form value changes for real-time updates
    this.form.controls.pumpCount.valueChanges.subscribe(value => {
      this.pumpCount.set(value);
    });

    this.form.controls.squareFootage.valueChanges.subscribe(value => {
      this.squareFootage.set(value);
    });

    // Load existing data if available
    const existingData = this.proformaService.getSiteAttributes();
    if (existingData) {
      this.form.patchValue(existingData);
    }
  }

  onSubmit(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }

    const formData = this.form.getRawValue();
    this.proformaService.updateSiteAttributes(formData);
    this.router.navigate(['/build/lease-details']); // Next step
  }

  onBack(): void {
    this.router.navigate(['/build']);
  }

  getFieldError(fieldName: string): string | null {
    const control = this.form.get(fieldName);
    if (!control || !control.touched || !control.errors) {
      return null;
    }

    const errors = control.errors;
    if (errors['required']) return 'This field is required';
    if (errors['min']) return `Minimum value is ${errors['min'].min}`;
    if (errors['max']) return `Maximum value is ${errors['max'].max}`;
    
    return 'Invalid value';
  }
}
```

