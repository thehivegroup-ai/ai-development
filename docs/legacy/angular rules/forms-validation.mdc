```typescript
// features/build/build-layout.component.ts
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterLink, RouterOutlet, Router } from '@angular/router';

interface NavSection {
  label: string;
  route: string;
  children?: NavSection[];
  completed?: boolean;
}

@Component({
  selector: 'app-build-layout',
  standalone: true,
  imports: [CommonModule, RouterLink, RouterOutlet],
  templateUrl: './build-layout.component.html',
  styleUrls: ['./build-layout.component.css']
})
export class BuildLayoutComponent {
  sections: NavSection[] = [
    { label: 'Deal Summary', route: '/build', completed: false },
    {
      label: 'Capital Needs',
      route: '/build/capital-needs',
      children: [
        { label: 'Site Attributes', route: '/build/site-attributes', completed: true },
        { label: 'Lease Details', route: '/build/lease-details', completed: false },
        { label: 'Financing Info', route: '/build/financing-info', completed: false },
      ]
    },
    {
      label: 'In-Store Model',
      route: '/build/in-store-model',
      children: [
        { label: 'Sales Volumes', route: '/build/sales-volumes', completed: false },
        { label: 'Merch/Food Mix', route: '/build/merch-food-mix', completed: false },
        { label: 'Margin', route: '/build/margin', completed: false },
      ]
    },
    {
      label: 'Fuel Model',
      route: '/build/fuel-model',
      children: [
        { label: 'Fuel Volume', route: '/build/fuel-volume', completed: false },
        { label: 'Gas/Diesel Mix', route: '/build/gas-diesel-mix', completed: false },
      ]
    },
    {
      label: 'Operating Expenses',
      route: '/build/operating-expenses',
      completed: false
    },
  ];

  constructor(public router: Router) {}

  isActive(route: string): boolean {
    return this.router.url === route;
  }
}
