# API Node Express

## Structure

- **Use Express middleware** for shared concerns (logging, auth, validation, error handling)
- **Validate request/response** at the route level using validation middleware
- **Keep route handlers thin** – Business logic lives in service layer
- **Standardize error responses** – Consistent error envelopes and status codes

## Route Organization

```typescript
// ✅ CORRECT: Modular route structure
// apps/api/src/routes/users.ts
import { Router } from 'express';
export const usersRouter = Router();

usersRouter.get('/', getAllUsers);
usersRouter.get('/:id', getUserById);
usersRouter.post('/', validateUserCreate, createUser);
usersRouter.put('/:id', validateUserUpdate, updateUser);
usersRouter.delete('/:id', deleteUser);

// apps/api/src/index.ts
import { usersRouter } from './routes/users';
app.use('/api/users', usersRouter);
```

## Request Validation

Use validation middleware (Zod, Joi, express-validator):

```typescript
// ✅ CORRECT: Zod validation middleware
import { z } from 'zod';

const createUserSchema = z.object({
  body: z.object({
    email: z.string().email(),
    name: z.string().min(1),
  }),
});

function validateRequest(schema: z.ZodSchema) {
  return async (req, res, next) => {
    try {
      await schema.parseAsync({
        body: req.body,
        query: req.query,
        params: req.params,
      });
      next();
    } catch (error) {
      res.status(400).json({
        error: {
          code: 'VALIDATION_ERROR',
          message: 'Invalid request data',
          details: error.errors,
        },
      });
    }
  };
}

router.post('/users', validateRequest(createUserSchema), async (req, res) => {
  const user = await userService.createUser(req.body);
  res.status(201).json(user);
});
```

## Error Handling

Use consistent error envelopes:

```typescript
// ✅ CORRECT: Standardized error response
{
  "error": {
    "code": "VALIDATION_ERROR" | "NOT_FOUND" | "UNAUTHORIZED" | "INTERNAL_ERROR",
    "message": "Human-readable error message",
    "details": { /* optional additional context */ }
  }
}

// ✅ CORRECT: Global error handler
app.use((err, req, res, next) => {
  console.error('[Error]', err);

  const statusCode = err.statusCode || 500;
  const errorCode = err.code || 'INTERNAL_ERROR';

  res.status(statusCode).json({
    error: {
      code: errorCode,
      message: err.message || 'Internal server error',
      ...(err.details && { details: err.details }),
    },
  });
});
```

## Status Codes

- `200` – Success with body
- `201` – Created
- `204` – Success, no body
- `400` – Bad request (validation failure)
- `401` – Unauthorized
- `403` – Forbidden
- `404` – Not found
- `409` – Conflict
- `500` – Server error

## Middleware Order

```typescript
// ✅ CORRECT: Middleware order matters
app.use(express.json());           // Body parser
app.use(express.urlencoded());     // URL-encoded parser
app.use(corsMiddleware);           // CORS
app.use(loggingMiddleware);        // Request logging
app.use(authMiddleware);           // Authentication (optional routes)

// Routes
app.use('/api/users', usersRouter);

// Error handler (MUST be last)
app.use(errorHandler);
```

## Service Layer Pattern

```typescript
// ✅ CORRECT: Thin controllers, fat services
// apps/api/src/routes/users.ts
export async function createUser(req: Request, res: Response, next: NextFunction) {
  try {
    const user = await userService.createUser(req.body);
    res.status(201).json(user);
  } catch (error) {
    next(error);  // Pass to error handler
  }
}

// apps/api/src/services/userService.ts
export class UserService {
  async createUser(data: CreateUserDto) {
    // Business logic here
    const user = await db.users.create(data);
    return user;
  }
}
```

